Content-Type: application/json

{
  "refreshToken": "TmAX58rstuVuHhVPbU0tVp4pTdN+7ve8S/gHppC+d74folC5g2nWMU81/PsjNRWGs76E0MD0Xo1TRq1cH2lUjQ==",
