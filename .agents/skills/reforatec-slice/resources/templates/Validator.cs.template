using FluentValidation;

namespace ReforaTec.Api.Features.{Domain}.{UseCase};

internal sealed class Validator : AbstractValidator<Request>
{
    public Validator()
    {
        RuleFor(x => x.Name)
            .NotEmpty()
            .MaximumLength(100);

        RuleFor(x => x.CapturedAt)
            .NotEmpty()
            .LessThanOrEqualTo(DateTimeOffset.UtcNow);
    }
}
