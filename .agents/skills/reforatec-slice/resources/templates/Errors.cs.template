using ErrorOr;

namespace ReforaTec.Api.Features.{Domain}.{UseCase};

internal static class Errors
{
    public static readonly Error NotFound = Error.NotFound(
        code: "{entity}/not-found",
        description: "The specified {entity} was not found in this tenant.");

    public static readonly Error Conflict = Error.Conflict(
        code: "{entity}/conflict",
        description: "The specified {entity} already exists in this tenant.");

    public static readonly Error Forbidden = Error.Forbidden(
        code: "{entity}/forbidden",
        description: "You do not have permission to access or operate on this {entity}.");
}
