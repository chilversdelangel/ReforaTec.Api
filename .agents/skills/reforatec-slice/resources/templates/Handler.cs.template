using ErrorOr;
using Microsoft.EntityFrameworkCore;
using ReforaTec.Api.Database;
using ReforaTec.Api.Infrastructure.Security.CurrentUser;

namespace ReforaTec.Api.Features.{Domain}.{UseCase};

internal static class Handler
{
    public static async Task<ErrorOr<Response>> Handle(
        UserIdentity user,
        Request request,
        AppDbContext context,
        CancellationToken cancellationToken)
    {
        // Enforce tenant isolation
        var entityExists = await context.{Entities}
            .Where(entity => entity.TenantId == user.TenantId)
            .Where(entity => entity.Name == request.Name)
            .AnyAsync(cancellationToken);

        if (entityExists)
        {
            return Errors.Conflict;
        }

        var entity = new {Entity}
        {
            TenantId = user.TenantId,
            Name = request.Name,
            CapturedAt = request.CapturedAt.UtcDateTime
        };

        context.{Entities}.Add(entity);
        await context.SaveChangesAsync(cancellationToken);

        return new Response(
            Id: entity.Id,
            Name: entity.Name,
            CreatedAt: entity.CreatedAt
        );
    }
}
