{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ReforaTec.Api",
    "ValidAudiences": [
      "ReforaTec.MobileApp",
      "ReforaTec.AdminDashboard"
    ],
    "SecretKey": "",
    "AccessTokenExpirationHours": 3,
    "RefreshTokenExpirationDays": 21,
    "MaxSessionsPerRole": {
      "Student": 2,
      "Inspector": 3,
      "Coordinator": 4,
      "SystemAdmin": 3
    }
  }
}
