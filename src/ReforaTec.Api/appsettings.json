{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "https://api.reforatec.org",
    "ValidAudiences": [
      "student-mobile-app",
      "inspector-mobile-app",
      "web-dashboard"
    ],
    "SecretKey": "",
    "AccessTokenExpirationHours": 3,
    "RefreshTokenExpirationDays": 21,
    "MaxSessionsPerRole": {
      "Student": 2,
      "Inspector": 3,
      "Coordinator": 4,
      "SystemAdmin": 3
    }
  },
  "LocalStorage": {
    "BaseUrl": ""
  },
  "Ingress": {
    "RealIpHeader": null
  },
  "RateLimiting": {
    "OtpIpMaxRequests": 30,
    "OtpIpWindowMinutes": 1,
    "OtpEmailMaxAttempts": 3,
    "OtpEmailWindowMinutes": 5,
    "GlobalMaxRequests": 100,
    "GlobalWindowMinutes": 1
  },
  "Notifications": {
    "Email": {
      "SenderName": "ReforaTec",
      "SenderEmail": "notificaciones@auth.reforatec.org",
      "ReplyToEmail": "soporte@reforatec.org",
      "Provider": "Resend",
      "Providers": {
        "Resend": {
          "ApiKey": "",
          "BaseUrl": "https://api.resend.com",
          "UserAgent": "reforatec-app",
          "TimeoutSeconds": 15
        }
      }
    }
  }
}
